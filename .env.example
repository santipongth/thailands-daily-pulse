# Thailand Daily Signals — configuration
# Copy to `.env` for local development (never commit `.env`).
# In production set the same names as server secrets (Cloudflare: `npx wrangler secret put NAME`).

# ── Required: database (Supabase cloud or self-hosted) ─────────────────────────
# Browser-visible (safe to expose): project URL + publishable/anon key
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT
# Server-only copies used by server functions / API routes
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only, bypasses row-level security. NEVER prefix with VITE_ or expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ── Required: scheduler secret ─────────────────────────────────────────────────
# Long random string (e.g. `openssl rand -hex 32`). Scheduled jobs send it as `Authorization: Bearer …`.
LOVABLE_CRON_SECRET=change-me
# Optional: previous secret, accepted during rotation
LOVABLE_CRON_SECRET_PREVIOUS=

# ── Recommended: public site address ───────────────────────────────────────────
# Used in sitemap, OpenAPI, llms.txt, share images and developer docs.
VITE_SITE_URL=https://signals.example.org
# Username "admin" on /admin/login maps to this email (any full email also works)
VITE_ADMIN_EMAIL=admin@example.org

# ── Optional: AI (brief intro, FM91 relevance tagging, LPG page reading, brief images) ──
# Any OpenAI-compatible API exposing /responses (and /images/generations for images).
# Default: Lovable AI gateway with LOVABLE_API_KEY. Without a key these features pause; the rest works.
AI_BASE_URL=
AI_API_KEY=
LOVABLE_API_KEY=

# ── Optional: Firecrawl (only for sites that block direct requests: X/Twitter, BMA flood, DDPM, EPPO LPG) ──
# Get a key at https://firecrawl.dev. Without it those sources report "blocked" honestly; others still run.
FIRECRAWL_API_KEY=
